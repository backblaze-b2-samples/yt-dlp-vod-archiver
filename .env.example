# Backblaze B2 (required) — S3-compatible API only.
B2_APPLICATION_KEY_ID=your_application_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name
# Region only — the S3 endpoint is derived as https://s3.<region>.backblazeb2.com
B2_REGION=your_region
# Optional: public base URL for the bucket (CDN or friendly URL). Leave blank to
# fall back to short-lived presigned URLs for downloads and inline previews.
B2_PUBLIC_URL_BASE=

# Example of what filled-in values look like (fake — for visual reference only):
# B2_APPLICATION_KEY_ID=005EXAMPLE_NOT_A_REAL_KEY_ID
# B2_APPLICATION_KEY=K005... (a ~31-char key, shown once when you create it)
# B2_BUCKET_NAME=my-vod-archive
# B2_REGION=us-west-004
# B2_PUBLIC_URL_BASE=https://my-vod-archive.s3.us-west-004.backblazeb2.com
