{
  "name": "yt-dlp-vod-archiver",
  "private": true,
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "sh scripts/dev.sh",
    "dev:web": "pnpm --filter @yt-dlp-vod-archiver/web dev",
    "dev:api": "cd services/api && .venv/bin/uvicorn main:app --reload --port ${API_PORT:-8000}",
    "build": "pnpm --filter @yt-dlp-vod-archiver/web build",
    "typecheck": "pnpm --filter @yt-dlp-vod-archiver/web typecheck",
    "lint": "pnpm --filter @yt-dlp-vod-archiver/web lint",
    "lint:api": "cd services/api && .venv/bin/ruff check .",
    "test:api": "cd services/api && .venv/bin/python -m pytest",
    "check:structure": "cd services/api && .venv/bin/python -m pytest tests/test_structure.py -v",
    "test:e2e": "pnpm --filter @yt-dlp-vod-archiver/web exec playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "lodash": "4.18.1",
      "postcss": "8.5.26",
      "sharp": "0.35.4",
      "browserslist": "4.28.7",
      "@hono/node-server": "1.19.15",
      "@humanfs/node": "0.16.8",
      "body-parser": "2.3.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "esbuild": "0.25.0",
      "express-rate-limit": "8.2.2",
      "fast-uri": "3.1.6",
      "flatted": "3.4.2",
      "hono": "4.12.34",
      "ip-address": "10.3.1",
      "js-yaml": "4.3.1",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "nanoid": "3.3.18",
      "path-to-regexp": "8.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss-selector-parser": "7.1.3",
      "qs": "6.16.0",
      "shell-quote": "1.9.0",
      "vite": "6.4.3",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0"
    }
  }
}
